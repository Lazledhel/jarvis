AIML_API_KEY=REPLACE_WITH_YOUR_KEY
AIML_MODEL=gpt-6-luna
PHONE_TOKEN=REPLACE_WITH_RANDOM_SHARED_SECRET
JARVIS_BIND_HOST=localhost
JARVIS_PORT=8765
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
JARVIS_TTS_ENGINE=piper
